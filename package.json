    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
